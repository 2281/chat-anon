# Строка подключения к PostgreSQL (asyncpg).
# Внимание: 5432 на хосте занят системным PostgreSQL (служба Windows),
# контейнер из docker-compose.yml публикуется на порт 5433.
DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5433/chatanon

# S3-совместимое хранилище (MinIO)
S3_ENDPOINT_URL=http://localhost:9000
# внутренний адрес для серверных вызовов (в compose: http://minio:9000)
S3_INTERNAL_ENDPOINT_URL=http://localhost:9000
# если задан, host в presigned URL заменяется на него (в compose: http://localhost:5173 —
# Vite проксирует пути бакета на MinIO). Пусто — прямые ссылки на S3_ENDPOINT_URL.
S3_PROXY_BASE_URL=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=chatanon
S3_REGION=us-east-1
