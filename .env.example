# Строка подключения к PostgreSQL (asyncpg).
# Контейнер из docker-compose.yml публикуется на порт 5433.
DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5433/chatanon

# S3-совместимое хранилище (MinIO)
S3_ENDPOINT_URL=http://localhost:9000
# внутренний адрес для серверных вызовов (в compose: http://minio:9000)
S3_INTERNAL_ENDPOINT_URL=http://localhost:9000
# режим прокси: любое непустое значение — presigned URL выдаются относительными
# (Vite проксирует пути бакета на MinIO, ссылки работают с любого устройства в сети).
# Пусто — прямые абсолютные ссылки на S3_ENDPOINT_URL.
S3_PROXY_BASE_URL=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=chatanon
S3_REGION=us-east-1
